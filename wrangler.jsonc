{
  "name": "yanju-alternatives",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },
  // Free cache. Create it once with:  npx wrangler kv namespace create ALT_KV
  // then paste the id it prints below (see SETUP.md).
  "kv_namespaces": [
    { "binding": "ALT_KV", "id": "PASTE_KV_NAMESPACE_ID_HERE" }
  ],
  "vars": {
    // Addresses allowed to call this server, comma separated. "*" means any (fine while testing).
    "ALLOWED_ORIGINS": "*"
  }
  // The secret APISH_KEY is NOT written here. Set it with:  npx wrangler secret put APISH_KEY
}
